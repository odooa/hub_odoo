<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hub_dossier_cle_wizard_view_form" model="ir.ui.view">
        <field name="name">hub.dossier.cle.wizard.form</field>
        <field name="model">hub.dossier.cle.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    La clé est testée sur l'Odoo du dossier, chiffrée avec la clé publique du
                    moteur, puis oubliée : elle ne pourra plus être relue.
                </p>
                <group>
                    <field name="dossier_id" readonly="1" force_save="1"/>
                    <field name="cle_api" password="True" required="1"/>
                </group>
                <footer>
                    <button name="action_valider" type="object" string="Tester et enregistrer"
                            class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
