<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hub_parametre_secret_wizard_view_form" model="ir.ui.view">
        <field name="name">hub.parametre.secret.wizard.form</field>
        <field name="model">hub.parametre.secret.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    La valeur est testée, chiffrée, puis oubliée : elle ne pourra plus être relue.
                </p>
                <group>
                    <field name="nom" readonly="1" force_save="1"/>
                    <field name="valeur" password="True" required="1"/>
                </group>
                <footer>
                    <button name="action_valider" type="object" string="Tester et enregistrer"
                            class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
