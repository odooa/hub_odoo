<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hub_fait_view_list" model="ir.ui.view">
        <field name="name">hub.fait.list</field>
        <field name="model">hub.fait</field>
        <field name="arch" type="xml">
            <list>
                <field name="dossier_id"/>
                <field name="cle"/>
                <field name="type_valeur"/>
                <field name="valeur"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hub_fait_view_form" model="ir.ui.view">
        <field name="name">hub.fait.form</field>
        <field name="model">hub.fait</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="dossier_id"/>
                            <field name="cle"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="type_valeur"/>
                            <field name="valeur"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Justification ou source du fait"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hub_fait_view_search" model="ir.ui.view">
        <field name="name">hub.fait.search</field>
        <field name="model">hub.fait</field>
        <field name="arch" type="xml">
            <search>
                <field name="cle"/>
                <field name="dossier_id"/>
                <field name="valeur"/>
                <filter name="archive" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_dossier" string="Dossier" context="{'group_by': 'dossier_id'}"/>
                    <filter name="group_cle" string="Clé" context="{'group_by': 'cle'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hub_fait_action" model="ir.actions.act_window">
        <field name="name">Faits</field>
        <field name="res_model">hub.fait</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
