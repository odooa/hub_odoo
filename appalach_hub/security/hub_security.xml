<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hub" model="ir.module.category">
        <field name="name">Hub comptable</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_hub" model="res.groups.privilege">
        <field name="name">Hub compta</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_hub"/>
    </record>

    <record id="group_hub_comptable" model="res.groups">
        <field name="name">Comptable</field>
        <field name="sequence">10</field>
        <field name="comment">Voit et modifie les dossiers dont il est comptable, et leurs faits.</field>
        <field name="privilege_id" ref="res_groups_privilege_hub"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hub_gestionnaire" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="sequence">20</field>
        <field name="comment">Accès complet au hub, y compris la définition des clés API.</field>
        <field name="privilege_id" ref="res_groups_privilege_hub"/>
        <field name="implied_ids" eval="[(4, ref('group_hub_comptable'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Groupe technique, hors privilège : réservé à l'utilisateur API du moteur. -->
    <record id="group_hub_moteur" model="res.groups">
        <field name="name">Hub / Moteur (technique)</field>
        <field name="comment">Lecture des dossiers, des faits et des clés API chiffrées.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
