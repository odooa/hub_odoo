<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Exécute les runs en file ; réveillé immédiatement par _trigger() au lancement et à la
         reprise. L'intervalle n'est qu'un filet de sécurité. -->
    <record id="ir_cron_hub_run" model="ir.cron">
        <field name="name">Hub compta : exécutions de l'agent</field>
        <field name="model_id" ref="model_hub_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_traiter()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="priority">5</field>
    </record>
</odoo>
